{
  "version": 1,
  "description": "Source of truth for Afrika-Veracode-Build test matrices (PR / Full / Release). Profiles select subsets; stability controls continue-on-error.",
  "profiles": {
    "pr": {
      "failFast": true,
      "description": "Fast representative matrix for pull_request and push to main (Gate)."
    },
    "full": {
      "failFast": false,
      "description": "All declared supported versions (schedule + workflow_dispatch)."
    },
    "release": {
      "failFast": false,
      "description": "Unit + negative + security + PR + Full before cutting a release tag."
    }
